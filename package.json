{
  "name": "real-estate-quest-ai-gen",
  "version": "1.0.0",
  "description": "Cloud Functions that generate AI real estate exam questions and flashcards with Claude for human review",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "generate:local": "node --env-file=local-generation.env scripts/generateLocally.js",
    "preview:local": "node --env-file-if-exists=local-generation.env scripts/previewGeneration.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^6.6.0"
  },
  "overrides": {
    "gaxios": {
      "uuid": "^11.1.1"
    },
    "google-gax": {
      "uuid": "^11.1.1"
    },
    "teeny-request": {
      "uuid": "^11.1.1"
    }
  }
}
