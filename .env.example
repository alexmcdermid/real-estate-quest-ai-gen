# Copy this file to .env for local development
# Never commit .env — it is gitignored
# See dev.md for full setup instructions

# ── Anthropic ────────────────────────────────────────────────────────────────
# API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── GitHub ───────────────────────────────────────────────────────────────────
# Fine-grained personal access token — scoped to real-estate-quest-questions only
# Permission needed: Contents → Read
# Create at: GitHub → Settings → Developer Settings → Fine-grained tokens
QUESTIONS_REPO_PAT=

# ── Firebase ─────────────────────────────────────────────────────────────────
# Service account for the real-estate-quest-ai Firebase project (NOT the prod project)
# Download from: Firebase Console → Project Settings → Service Accounts → Generate new private key
# Paste the entire JSON as a single line (convert with: cat key.json | tr -d '\n')
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Local overrides (optional) ───────────────────────────────────────────────
# Target a specific chapter instead of the automatic weekly rotation (1-20)
# CHAPTER_OVERRIDE=3

# Skip the Firestore write and log the generated question to stdout instead
# DRY_RUN=true
