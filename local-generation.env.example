# Settings for npm run generate:local. Copy this file to local-generation.env (gitignored) and fill it in.
# Never name it .env: the Firebase CLI deploys a .env file in the functions folder as plain environment variables.
# Firestore access uses Application Default Credentials: run `gcloud auth application-default login` first.

# Anthropic API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# The Firebase project (both Firestore databases live in it)
GOOGLE_CLOUD_PROJECT=real-estate-quest

# Optional: a chapter (1-20) instead of this week's rotation
# CHAPTER_OVERRIDE=3

# Optional: how many questions (1-10) instead of the questionsPerRun setting
# QUESTION_COUNT=2

# Optional: print the questions without adding them to the review queue (the run is still recorded)
# DRY_RUN=true
